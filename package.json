{
  "name": "mr-mak-workspace",
  "private": true,
  "version": "0.6.0",
  "type": "module",
  "scripts": {
    "postinstall": "npm --prefix desktop/service ci && node scripts/fix-pty-permissions.mjs",
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "eslint src",
    "preview": "vite preview",
    "desktop:service": "node desktop/service/main.mjs",
    "desktop:prepare": "node desktop/prepare.mjs",
    "desktop:build": "tauri build",
    "desktop:dev": "tauri dev",
    "desktop:test": "node --test desktop/service/test/*.test.mjs desktop/service/exchange/test/*.test.mjs",
    "desktop:test:ui": "node desktop/service/test/ui.mjs && node desktop/service/test/links-ui.mjs && node desktop/service/test/scroll-ui.mjs && node desktop/service/test/history-ui.mjs && node desktop/service/test/groups-ui.mjs && node desktop/service/test/conversation-ui.mjs && node desktop/service/test/theme-ui.mjs && node desktop/service/exchange/test/chats-ui.mjs",
    "test": "npm run desktop:test",
    "test:repo": "node scripts/exchange/check-repo.mjs && node scripts/sync-skills.mjs --check",
    "skills:sync": "node scripts/sync-skills.mjs"
  },
  "dependencies": {
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/addon-web-links": "^0.12.0",
    "@xterm/xterm": "^6.0.0",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.63.0",
    "@tauri-apps/cli": "^2.11.4",
    "@types/node": "^24.12.2",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "eslint": "^10.4.1",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "globals": "^17.6.0",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.61.0",
    "vite": "^8.0.4"
  },
  "engines": {
    "node": ">=22.20.0"
  }
}
